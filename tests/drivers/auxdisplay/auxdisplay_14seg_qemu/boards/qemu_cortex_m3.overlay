#include <zephyr/dt-bindings/clock/stm32l4_clock.h>
#include <freq.h>

/ {
	chosen {
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
	};

	soc {
		rcc: rcc@40021000 {
			compatible = "st,stm32-rcc";
			#clock-cells = <2>;
			reg = <0x40021000 0x400>;
		};

		pinctrl: pin-controller@48000000 {
			compatible = "st,stm32-pinctrl";
			reg = <0x48000000 0x2000>;
			#address-cells = <1>;
			#size-cells = <1>;
			reg = <0x48000000 0x2000>;
			ranges;
		};

		slcd: display-controller@40002400 {
			compatible = "st,slcd";
			reg = <0x40002400 0x400>;
			clocks = <&rcc STM32_CLOCK(APB1, 9)>, <&rcc STM32_SRC_LSE RTC_SEL(1)>;
			clock-names = "bus", "device";
		};
	};
};

&uart0 {
    status = "okay";
    current-speed = <115200>;
};

&rcc {
	//clocks = <&pll>;
	clock-frequency = <DT_FREQ_M(80)>;
	ahb-prescaler = <1>;
	apb1-prescaler = <1>;
	apb2-prescaler = <1>;
};

&slcd {
	status = "okay";
	lcd-duty = <0x0000000c>;
	lcd-bias = <0x00000040>;
	lcd-mux-segment = <0>;
	lcd-voltage-source = <0>;
	lcd-prescaler = <0>;
	lcd-divider = <0x003c0000>;
	lcd-contrast = <0x00001400>;
	lcd-pulse-on-duration = <0x00000040>;
	lcd-dead-time = <0>;
	lcd-high-drive = <0>;
	lcd-blink-mode = <0>;
	lcd-blink-frequency = <0x00004000>;
	pinctrl-0 = <&lcd_seg3_pa6 &lcd_seg4_pa7 &lcd_com0_pa8
		     &lcd_com1_pa9 &lcd_com2_pa10 &lcd_seg17_pa15
		     &lcd_seg5_pb0 &lcd_seg6_pb1 &lcd_seg8_pb4
		     &lcd_seg9_pb5 &lcd_com3_pb9 &lcd_seg12_pb12
		     &lcd_seg13_pb13 &lcd_seg14_pb14 &lcd_seg15_pb15
		     &lcd_vlcd_pc3 &lcd_seg22_pc4 &lcd_seg23_pc5
		     &lcd_seg24_pc6 &lcd_seg25_pc7 &lcd_seg26_pc8
		     &lcd_seg28_pd8 &lcd_seg29_pd9 &lcd_seg30_pd10 &lcd_seg31_pd11
		     &lcd_seg32_pd12 &lcd_seg33_pd13 &lcd_seg34_pd14 &lcd_seg35_pd15>;
	pinctrl-names = "default";
	pin-list = <4 23 6 13 15 29 31 33 35 25 17 8 9 26 24 34 32 30 28 14 12 5 22 3>;
	com-list = <0 2 4 6 1 3 5 7>;
	character-bit-list = <
			      /* MCU AFP11 channel for segment 1A-1P */
			      (1 << 22) (1 << 22) (1 << 23) (1 << 4) (1 << 4) (1 << 3) (1 << 3)
			      (1 << 3) (1 << 22) (1 << 22) (1 << 23) (1 << 4) (1 << 4) (1 << 3)
			      /* MCU AFP11 channel for segment 2A-2P */
			      (1 << 12) (1 << 12) (1 << 13) (1 << 6) (1 << 6) (1 << 5) (1 << 5)
			      (1 << 5) (1 << 12) (1 << 12) (1 << 13) (1 << 6) (1 << 6) (1 << 5)
			      /* MCU AFP11 channel for segment 1A-1P */
			      (1 << 28) (1 << 28) (1 << 29) (1 << 15) (1 << 15) (1 << 14) (1 << 14)
			      (1 << 14) (1 << 28) (1 << 28) (1 << 29) (1 << 15) (1 << 15) (1 << 14)
			      /* MCU AFP11 channel for segment 2A-2P */
			      (1 << 0) (1 << 0) (1 << 1) (1 << 31) (1 << 31) (1 << 30) (1 << 30)
			      (1 << 30) (1 << 0) (1 << 0) (1 << 1) (1 << 31) (1 << 31) (1 << 30)
			      /* MCU AFP11 channel for segment 3A-3P */
			      (1 << 24) (1 << 24) (1 << 25) (1 << 3) (1 << 3) (1 << 2) (1 << 2)
			      (1 << 2)
			      (1 << 24) (1 << 24) (1 << 25) (1 << 3) (1 << 3) (1 << 2)
			      /* MCU AFP11 channel for segment 4A-4P */
			      (1 << 9) (1 << 9) (1 << 8) (1 << 17) (1 << 17) (1 << 26) (1 << 26)
			      (1 << 26)
			      (1 << 9) (1 << 9) (1 << 8) (1 << 17) (1 << 17) (1 << 26)>;
	character-com-list = <
			      /* COM RAM register for segment 1A-1P */
			      2 0 2 2 0 2 0 6 6 4 0 6 4 4
			      /* COM RAM register for segment 2A-2P */
			      2 0 2 2 0 2 0 6 6 4 0 6 4 4
			      /* COM RAM register for segment 1A-1P */
			      2 0 2 2 0 2 0 6 6 4 0 6 4 4
			      /* COM RAM register for segment 2A-2P */
			      3 1 3 2 0 2 0 6 7 5 1 6 4 4
			      /* COM RAM register for segment 3A-3P */
			      2 0 2 3 1 3 1 7 6 4 0 7 5 5
			      /* COM RAM register for segment 4A-4P */
			      2 0 2 2 0 2 0 6 6 4 0 6 4 4>;
	indicator-bit-list = <(1 << 23) (1 << 23) (1 << 13) (1 << 13)
			      (1 << 29) (1 << 29) (1 << 1) (1 << 1)
			      (1 << 8) (1 << 8) (1 << 25) (1 << 25)>;
	indicator-com-list = <6 4 6 4 6 4 7 5 6 4 6 4>;
	custom-character-slot-count = <32>;
};

auxdisplay_0: &slcd {
	slcd_panel: st_gh08172t {
		compatible = "slcd-panel";
		columns = <6>;
		rows = <1>;
		segment-type = <14>; /* 14 segment SLCD panel */
		/* Which pin controls which segment. 6 positions x 14 segments = 84 elements.
		 * Segment order per position: A B C D E F G H J K M N O P
		 * Since the display starts from left to right
		 */
		segment-pins = <
				/* Pins for dig1 segments(1A~1P) */
				22 22 1 0 0 23 23 23 22 22 1 0 0 23
				/* Pins for dig2 segments(2A~2P) */
				20 20 3 2 2 21 21 21 20 20 3 2 2 21
				/* Pins for dig3 segments(3A~3P) */
				18 18 5 4 4 19 19 19 18 18 5 4 4 19
				/* Pins for dig4 segments(4A~4P) */
				16 16 7 6 6 17 17 17 16 16 7 6 6 17
				/* Pins for dig5 segments(5A~5P) */
				14 14 9 8 8 15 15 15 14 14 9 8 8 15
				/* Pins for dig6 segments(6A~6P) */
				12 12 11 10 10 13 13 13 12 12 11 10 10 13>;

		/* Which com controls which segment. 6 positions x 14 segments = 84 elements. */
		segment-coms = <
				/* COMs for dig1 segments(1A~1P) */
				1 0 1 1 0 1 0 3 3 2 0 3 2 2
				/* COMs for dig2 segments(2A~2P) */
				1 0 1 1 0 1 0 3 3 2 0 3 2 2
				/* COMs for dig3 segments(3A~3P) */
				1 0 1 1 0 1 0 3 3 2 0 3 2 2
				/* COMs for dig4 segments(4A~4P) */
				1 0 1 1 0 1 0 3 3 2 0 3 2 2
				/* COMs for dig5 segments(5A~5P) */
				1 0 1 1 0 1 0 3 3 2 0 3 2 2
				/* COMs for dig6 segments(6A~6P) */
				1 0 1 1 0 1 0 3 3 2 0 3 2 2>;

		num-indicators = <12>;
		indicator-pins = <1 1 3 3 5 5 7 7 11 11 9 9>;
		indicator-coms = <3 2 3 2 3 2 3 2 3 2 3 2>;
		display-indicators = <
				      /* Single dot */
				      0 2 4 6 0xff 0xff
				      /* Double dot (colon) */
				      1 3 5 7 0xff 0xff
				      /* 4 bars, BAR0-BAR3 */
				      0xff 0xff 0xff 0xff 0xff 8
				      0xff 0xff 0xff 0xff 0xff 9
				      0xff 0xff 0xff 0xff 0xff 10
				      0xff 0xff 0xff 0xff 0xff 11>;
	};
};

#include <zephyr/dt-bindings/pinctrl/stm32-pinctrl.h>

&pinctrl {
	/* LCD */

	/omit-if-no-ref/ lcd_seg0_pa1: lcd_seg0_pa1 {
		pinmux = <STM32_PINMUX('A', 1, AF11)>;
	};

	/omit-if-no-ref/ lcd_seg1_pa2: lcd_seg1_pa2 {
